<h2>{{book.title}}</h2>

<div class="review-container">
<p>In {{ book.finished | bookDateYear }} I read <a href="{{ book.link }}">{{ book.title }}</a> by {{ book.author }}.</p>
{% if book.situ %}
{% set alt = ["a picture of '", book.title, "' by ", book.author, " in situ."] | join %}
{% blogpic book.situ, alt %}
{% endif %}
<div class="review-text">
<h4 id="timeline" tabindex="-1"><a class="header-anchor" href="#timeline">Timeline</a></h4>
{% if book.started %}
<ul class="timeline">
 <li><strong>{{ book.started | readableBookDate }}:</strong> started reading.</li>
 <li><strong>{{ book.finished | readableBookDate}}:</strong> finished reading.</li>
</ul>
{% else %}
<ul class="timeline">
 <li>...started reading at some point.</li>
 <li><strong>{{ book.finished | readableBookDate}}:</strong> finished reading.</li>
</ul>
{% endif %}

{% if book.review %}
<h4 id="review" tabindex="-1"><a class="header-anchor" href="#review">Review</a></h4>
{{ book.review | safe }}
{% endif %}
</div>
</div>

{% if book.publisher and book.pages and book.isbn %}
<h4 id="details" tabindex="-1"><a class="header-anchor" href="#details">Details</a></h4>
<ul>
    <li><strong>Publisher:</strong> {{ book.publisher }}</li>
    <li><strong>Page Count:</strong> {{ book.pages }}</li>
    <li><strong>ISBN:</strong> {{ book.isbn }}</li>
</ul>
{% endif %}
<hr />
