{
  "name": "cyberbspace",
  "version": "1.0.0",
  "description": "personal website",
  "main": ".eleventy.js",
  "engines": {
    "node": "~26.7.0",
    "npm": "~12.1.0"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "@notionhq/client": "^2.3.0",
    "clean-css": "^4.2.1",
    "d3-geo": "^2.0.2",
    "d3-geo-projection": "^3.0.0",
    "luxon": "^1.28.1",
    "markdown-it": "^14.1.1",
    "markdown-it-footnote": "^3.0.3",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "glob": "^11.0.0",
    "husky": "^9.1.7",
    "markdown-it-anchor": "^10.0.0",
    "spellchecker-cli": "^7.0.4"
  },
  "scripts": {
    "test": "test",
    "build": "npx @11ty/eleventy",
    "start": "npx eleventy --serve --formats=md",
    "dither": "./bin/dither.zsh",
    "reading": "node ./bin/fetch-currently-reading.js",
    "have-read": "node ./bin/fetch-read.js",
    "spellcheck": "npx spellchecker --config .spellcheckerrc.json",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riastrad/cyberbspace.git"
  },
  "keywords": [
    "website",
    "personal",
    "eleventy",
    "static"
  ],
  "author": "@riastrad",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/riastrad/cyberbspace/issues"
  },
  "homepage": "https://cyberb.space",
  "allowScripts": {
    "fsevents@2.3.2": true,
    "sharp@0.34.2": true
  }
}
